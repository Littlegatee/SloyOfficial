{
  "name": "Sloy",
  "short_name": "Sloy",
  "id": "/",
  "start_url": "/feed",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b1020",
  "theme_color": "#7c3aed",
  "description": "Sloy social web app",
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Лента",
      "short_name": "Лента",
      "url": "/feed"
    },
    {
      "name": "Сообщения",
      "short_name": "Чаты",
      "url": "/messages"
    }
  ],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "192x192",
      "type": "image/x-icon",
      "purpose": "any"
    },
    {
      "src": "/favicon.ico",
      "sizes": "512x512",
      "type": "image/x-icon",
      "purpose": "any maskable"
    }
  ]
}
