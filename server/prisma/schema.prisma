generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  FILE
  NONE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum MessagePermission {
  EVERYONE
  FRIENDS
  NOBODY
}

enum CommentMediaType {
  TEXT
  VOICE
  NONE
}

enum CommunityType {
  CHANNEL
  GROUP
}

enum CommunityRole {
  MEMBER
  MODERATOR
  ADMIN
  OWNER
  PRODUCT_EDITOR
  CHAT_MODERATOR
  ANALYST
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum MusicVisibility {
  PRIVATE
  PUBLIC
}

// ============================================
// MODELS
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  is_admin  Boolean  @default(false)

  // Relations
  profile      Profile?
  posts        Post[]
  comments     Comment[]
  likes          Like[]           // Лайки на посты
  commentLikes   CommentLike[]    // Лайки на комментарии
  postViews      PostView[]       // Просмотры постов
  bookmarks      Bookmark[]
  postPollVotes  PostPollVote[]
  pollVotes       PollVote[]
  ratings        CommunityRating[]
  orders         Order[]
  productReviews ProductReview[]

  // Messages
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  messageHidden    MessageHidden[]

  // Friendships
  friendships      Friendship[] @relation("UserFriendships")
  friendOf         Friendship[] @relation("FriendFriendships")

  // Communities
  communityMemberships CommunityMember[]

  musicTracks   MusicTrack[]
  musicAlbums   MusicAlbum[]
  musicPlaylists Playlist[]

  // Blocks
  blockedUsers  UserBlock[] @relation("Blocker")
  blockedBy     UserBlock[] @relation("Blocked")

  // Pins
  pinnedDialogs  DialogPin[]
  pinnedMessages MessagePin[]

  // Reactions & mutes
  messageReactions MessageReaction[]
  dialogMutes      DialogMute[]
  dialogArchives   DialogArchive[]
  pushSubscriptions PushSubscription[]
  
// New features
  chatFolders     ChatFolder[]
  chatDrafts      ChatDraft[]
  chatConfigs     UserChatConfig[]

  @@index([email])
}

model PushSubscription {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
}

model Profile {
  id          String   @id @default(uuid())
  user_id     String   @unique
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  username    String   @unique
  first_name  String
  last_name   String?
  avatar_url  String?
  cover_url   String?
  status      String?
  city        String?
  country     String?
  language    String?
  interests   String?  @db.Text
  gender      String?
  favorite_movies String? @db.Text
  favorite_games  String? @db.Text
  birth_date  String?
  telegram_id String?
  is_verified Boolean  @default(false)
  
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Privacy
  allow_online_status Boolean @default(true)
  allow_last_seen     Boolean @default(true)
  allow_messages_from MessagePermission @default(FRIENDS)
  profile_visibility  ProfileVisibility @default(PUBLIC)
  allow_friend_requests Boolean @default(true)

  // Music pinned track
  pinned_track_id String?
  pinned_track    MusicTrack? @relation("PinnedTrack", fields: [pinned_track_id], references: [id], onDelete: SetNull)

  @@index([username])
}

model Post {
  id             String    @id @default(uuid())
  user_id        String
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  content_text   String    @db.Text
  media_type     MediaType @default(NONE)
  media_url      String?
  
  likes_count    Int       @default(0)
  comments_count Int       @default(0)
  views_count    Int       @default(0)
  is_edited      Boolean   @default(false)
  
  author_type    String    @default("USER") // "USER" | "COMMUNITY"
  community_id   String?
  community      Community? @relation(fields: [community_id], references: [id], onDelete: Cascade)

  // Reposts
  is_repost        Boolean   @default(false)
  original_post_id String?
  original_post    Post?     @relation("Reposts", fields: [original_post_id], references: [id], onDelete: SetNull)
  reposts          Post[]    @relation("Reposts")

  // Promotion
  is_promoted      Boolean   @default(false)

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Relations
  comments       Comment[]
  likes          Like[]
  views          PostView[]
  bookmarks      Bookmark[]
  tags           PostTag[]
  poll           PostPoll?

  @@index([user_id])
  @@index([created_at])
  @@index([original_post_id])
}

model Tag {
  id         String    @id @default(uuid())
  name       String    @unique
  posts      PostTag[]
  created_at DateTime  @default(now())

  @@index([name])
}

model PostTag {
  post_id String
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag_id  String
  tag     Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([post_id, tag_id])
  @@index([post_id])
  @@index([tag_id])
}

model Bookmark {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_id    String?
  post       Post?    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  product_id String?
  product    CommunityProduct? @relation(fields: [product_id], references: [id], onDelete: Cascade)
  community_id String?
  community  Community? @relation(fields: [community_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@unique([user_id, product_id])
  @@unique([user_id, community_id])
  @@index([user_id])
}

model PostPoll {
  id         String       @id @default(uuid())
  post_id    String       @unique
  post       Post         @relation(fields: [post_id], references: [id], onDelete: Cascade)
  question   String
  options    Json         // [{ id: string, text: string }]
  multiple   Boolean      @default(false)
  closed     Boolean      @default(false)
  votes      PostPollVote[]
}

model PostPollVote {
  id         String   @id @default(uuid())
  poll_id    String
  poll       PostPoll @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  option_id  String
  created_at DateTime @default(now())

  @@unique([poll_id, user_id])
  @@index([poll_id])
  @@index([user_id])
}

model PostView {
  id         String   @id @default(uuid())
  post_id    String
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([post_id, user_id])
  @@index([post_id])
  @@index([user_id])
}

model Comment {
  id           String           @id @default(uuid())
  post_id      String
  post         Post             @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user_id      String
  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  // Nested comments (tree structure)
  parent_id    String?
  parent       Comment?         @relation("CommentToComment", fields: [parent_id], references: [id], onDelete: Cascade)
  replies      Comment[]        @relation("CommentToComment")
  
  // Comment content
  content_text String?          @db.Text
  media_type   CommentMediaType @default(TEXT)
  voice_url    String?
  voice_duration Int?
  
  likes_count  Int              @default(0)     // Счетчик лайков для быстрого отображения
  is_edited    Boolean          @default(false) // Флаг: был ли коммент изменен
  
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  // Relations
  likes        CommentLike[]

  @@index([post_id])
  @@index([user_id])
  @@index([parent_id])
  @@index([created_at])
}

// Модель для лайков постов
model Like {
  id         String   @id @default(uuid())
  post_id    String
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([post_id, user_id]) // Защита от двойного лайка
  @@index([post_id])
}

// НОВАЯ МОДЕЛЬ: Лайки для комментариев
model CommentLike {
  id         String   @id @default(uuid())
  comment_id String
  comment    Comment  @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([comment_id, user_id]) // Защита от двойного лайка на коммент
  @@index([comment_id])
}

enum MessageType {
  TEXT
  VOICE
  STICKER
  MEDIA
  FILE
  VIDEO_CIRCLE
  POLL
}

model Message {
  id           String   @id @default(uuid())
  sender_id    String
  sender       User     @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient_id String
  recipient    User     @relation("ReceivedMessages", fields: [recipient_id], references: [id], onDelete: Cascade)
  
  reply_to_id  String?
  reply_to     Message?  @relation("MessageReplies", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies      Message[] @relation("MessageReplies")

  message_type MessageType @default(TEXT)
  content_text String?  @db.Text
  media_url    String?
  voice_duration Int?
  
  // Album/Gallery grouping
  album_id     String?
  
  // Link Previews
  link_preview Json?

  is_read      Boolean  @default(false)
  is_edited    Boolean  @default(false)
  created_at   DateTime @default(now())

  hiddenBy     MessageHidden[]
  forwarded_from_id String?
  forwarded_from    Message? @relation("ForwardedFrom", fields: [forwarded_from_id], references: [id], onDelete: SetNull)
  forwards          Message[] @relation("ForwardedFrom")
  pinnedBy          MessagePin[]
  reactions         MessageReaction[]

  @@index([sender_id])
  @@index([recipient_id])
  @@index([reply_to_id])
  @@index([created_at])
  @@index([forwarded_from_id])
  @@index([album_id])
}

model ChatFolder {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name        String
  icon        String?
  filters     Json     // { types: ["PRIVATE", "GROUPS", "UNREAD"], includeIds: [], excludeIds: [] }
  position    Int      @default(0)
  created_at  DateTime @default(now())

  @@index([user_id])
}

model ChatDraft {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  recipient_id  String
  content_text  String?  @db.Text
  reply_to_id   String?
  updated_at    DateTime @updatedAt

  @@unique([user_id, recipient_id])
  @@index([user_id])
}

model Poll {
  id            String   @id @default(uuid())
  message_id    String   @unique
  question      String
  options       Json     // [{ id: 1, text: "Yes" }, { id: 2, text: "No" }]
  multiple      Boolean  @default(false)
  anonymous     Boolean  @default(false)
  closed        Boolean  @default(false)
  created_at    DateTime @default(now())
  
  votes         PollVote[]
}

model PollVote {
  id         String   @id @default(uuid())
  poll_id    String
  poll       Poll     @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  option_id  Int
  created_at DateTime @default(now())

  @@unique([poll_id, user_id, option_id])
  @@index([poll_id])
  @@index([user_id])
}

model StickerPack {
  id          String    @id @default(uuid())
  name        String
  title       String
  thumbnail   String?
  created_at  DateTime  @default(now())
  stickers    Sticker[]
}

model Sticker {
  id          String      @id @default(uuid())
  pack_id     String
  pack        StickerPack @relation(fields: [pack_id], references: [id], onDelete: Cascade)
  media_url   String
  emoji       String?
  position    Int         @default(0)

  @@index([pack_id])
}

model UserChatConfig {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  other_user_id String
  bubble_color  String?  // hex color
  text_color    String?  // hex color
  notif_sound   String?  // sound identifier

  @@unique([user_id, other_user_id])
  @@index([user_id])
}

model MessageReaction {
  id         String   @id @default(uuid())
  message_id String
  message    Message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  emoji      String
  created_at DateTime @default(now())

  @@unique([message_id, user_id, emoji])
  @@index([message_id])
  @@index([user_id])
  @@index([emoji])
}

model DialogMute {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  other_user_id String
  muted_until   DateTime?
  muted_forever Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([user_id, other_user_id])
  @@index([user_id])
  @@index([other_user_id])
  @@index([muted_until])
}

model DialogArchive {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  other_user_id String
  archived_at   DateTime @default(now())

  @@unique([user_id, other_user_id])
  @@index([user_id])
  @@index([other_user_id])
  @@index([archived_at])
}

// Per-user message hiding ("delete for me")
model MessageHidden {
  id         String   @id @default(uuid())
  message_id String
  message    Message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  hidden_at  DateTime @default(now())

  @@unique([message_id, user_id])
  @@index([user_id])
  @@index([message_id])
}

model UserBlock {
  id         String   @id @default(uuid())
  blocker_id String
  blocker    User     @relation("Blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked_id String
  blocked    User     @relation("Blocked", fields: [blocked_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])
}

model DialogPin {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  other_user_id String
  pinned_at     DateTime @default(now())

  @@unique([user_id, other_user_id])
  @@index([user_id])
  @@index([other_user_id])
}

model MessagePin {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  message_id String
  message    Message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  pinned_at  DateTime @default(now())

  @@unique([user_id, message_id])
  @@index([user_id])
  @@index([message_id])
}

model Friendship {
  id         String           @id @default(uuid())
  user_id    String
  user       User             @relation("UserFriendships", fields: [user_id], references: [id], onDelete: Cascade)
  friend_id  String
  friend     User             @relation("FriendFriendships", fields: [friend_id], references: [id], onDelete: Cascade)
  
  status     FriendshipStatus @default(PENDING)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  @@unique([user_id, friend_id])
  @@index([user_id])
  @@index([friend_id])
}

model Community {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  avatar_url  String?
  cover_url   String?
  type        CommunityType
  category    String?       // New field for categories
  is_verified Boolean       @default(false) // Verification for communities
  
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  members     CommunityMember[]
  posts       Post[]
  products    CommunityProduct[]
  bookmarks   Bookmark[]
  ratings     CommunityRating[]
  orders      Order[]

  @@index([category])
}

model CommunityRating {
  id           String    @id @default(uuid())
  community_id String
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  rating       Int       // 1-5
  review_text  String?   @db.Text
  created_at   DateTime  @default(now())

  @@unique([community_id, user_id])
  @@index([community_id])
}

model CommunityProduct {
  id           String    @id @default(uuid())
  community_id String
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  
  title        String
  description  String?   @db.Text
  price        Float?
  currency     String    @default("RUB")
  image_url    String?
  category     String?
  
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  bookmarks    Bookmark[]
  reviews      ProductReview[]
  orders       Order[]

  @@index([community_id])
  @@index([category])
}

model ProductReview {
  id          String           @id @default(uuid())
  product_id  String
  product     CommunityProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user_id     String
  user        User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  rating      Int              // 1-5
  text        String?          @db.Text
  created_at  DateTime         @default(now())

  @@unique([product_id, user_id])
  @@index([product_id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id           String           @id @default(uuid())
  user_id      String
  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  community_id String
  community    Community        @relation(fields: [community_id], references: [id], onDelete: Cascade)
  product_id   String
  product      CommunityProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  status       OrderStatus      @default(PENDING)
  quantity     Int              @default(1)
  total_price  Float
  currency     String           @default("RUB")
  
  customer_note String?         @db.Text
  admin_note    String?         @db.Text
  
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  @@index([user_id])
  @@index([community_id])
  @@index([product_id])
}

model CommunityMember {
  id           String        @id @default(uuid())
  community_id String
  community    Community     @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user_id      String
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  role         CommunityRole @default(MEMBER)
  joined_at    DateTime      @default(now())

  @@unique([community_id, user_id])
  @@index([user_id])
  @@index([community_id])
}

model MusicTrack {
  id           String          @id @default(uuid())
  user_id      String
  user         User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title        String
  artist       String?
  file_url     String          @db.Text
  cover_url    String?         @db.Text
  duration_sec Int?
  visibility   MusicVisibility @default(PRIVATE)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  albumLinks   MusicAlbumTrack[]
  playlistLinks PlaylistTrack[]

  // Profiles that pin this track
  pinned_by    Profile[]      @relation("PinnedTrack")

  @@index([user_id])
  @@index([created_at])
}

model MusicAlbum {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  cover_url  String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tracks MusicAlbumTrack[]

  @@index([user_id])
}

model MusicAlbumTrack {
  id       String     @id @default(uuid())
  album_id String
  album    MusicAlbum @relation(fields: [album_id], references: [id], onDelete: Cascade)
  track_id String
  track    MusicTrack @relation(fields: [track_id], references: [id], onDelete: Cascade)
  position Int        @default(0)

  @@unique([album_id, track_id])
  @@index([album_id])
}

model Playlist {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  cover_url  String?  @db.Text
  is_public  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tracks PlaylistTrack[]

  @@index([user_id])
}

model PlaylistTrack {
  id          String   @id @default(uuid())
  playlist_id String
  playlist    Playlist @relation(fields: [playlist_id], references: [id], onDelete: Cascade)
  track_id    String
  track       MusicTrack @relation(fields: [track_id], references: [id], onDelete: Cascade)
  position    Int        @default(0)

  @@unique([playlist_id, track_id])
  @@index([playlist_id])
}
